# Copy thành .env cùng thư mục rồi điền giá trị: cp .env.example .env
# .env đã khớp .gitignore gốc (mọi thư mục), không commit.
#
# Sinh chuỗi ngẫu nhiên bằng: openssl rand -hex 32
# ENCRYPTION_KEY bắt buộc đúng 64 ký tự hex (32 byte) — openssl rand -hex 32 cho đúng độ dài.

POSTGRES_USER=langfuse
POSTGRES_PASSWORD=
POSTGRES_DB=langfuse

REDIS_AUTH=

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=

# Langfuse app
SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
TELEMETRY_ENABLED=false

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
