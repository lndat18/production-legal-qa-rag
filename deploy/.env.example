# Mẫu biến môi trường cho deploy/docker-compose.yml (deploy_spec.md mục 7).
# Copy thành deploy/.env rồi điền giá trị thật:
#   cp deploy/.env.example deploy/.env
# deploy/.env KHÔNG commit (đã khớp bởi .gitignore ".env" ở mọi thư mục).
# Không truyền bí mật qua build-arg hay bake vào image.

# --- Compose (chọn chế độ Cloudflare Tunnel, mục 3) ---
# "quick": không cần domain, URL đổi mỗi lần khởi động lại (mặc định).
# "named": cần TUNNEL_TOKEN + domain đã trỏ trên Cloudflare dashboard, URL cố định.
COMPOSE_PROFILES=quick

# --- LLM / dịch vụ ngoài ---
GROQ_API_KEY=
GROQ_API_KEY_2=
HF_TOKEN=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_SPARSE_INDEX_NAME=

# --- Backend (api) ---
# Sinh ngẫu nhiên >= 32 ký tự, vd: python -c "import secrets; print(secrets.token_urlsafe(32))"
CHATBOT_API_KEY=
REDIS_PASSWORD=
# docker-compose.yml tự dựng đúng giá trị 2 biến dưới đây cho service `api` từ
# REDIS_PASSWORD/POSTGRES_USER/POSTGRES_PASSWORD ở trên/dưới (env_file không tự giãn
# ${VAR} bên trong chính .env — mục 7). Chỉ cần điền nếu chạy `api` ngoài compose (vd. gọi
# trực tiếp trên host để debug), giữ đúng định dạng bên dưới.
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CHATLOG_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres/chatbot

# --- Postgres (dùng chung cho 2 DB openwebui + chatbot, xem deploy/initdb/) ---
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- OpenWebUI ---
# Cố định, không đổi sau khi đã có người dùng đăng nhập — đổi sẽ làm mất mọi phiên đăng
# nhập hiện có (mục 8, mục 9).
WEBUI_SECRET_KEY=
# Chỉ cần khi COMPOSE_PROFILES=named (URL cố định); bỏ trống khi dùng quick tunnel.
WEBUI_URL=

# --- Tunnel ---
# Chỉ cần khi COMPOSE_PROFILES=named.
TUNNEL_TOKEN=
