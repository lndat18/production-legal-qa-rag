# Biến môi trường cho stack Docker. Chạy ./deploy/up.sh — tự tạo deploy/.env từ file này.
# KHÔNG commit deploy/.env. Hướng dẫn từng biến: README.md, mục "Deploy Docker".

# Chế độ tunnel: quick (mặc định, không cần domain) hoặc named
COMPOSE_PROFILES=quick

# ── [BẮT BUỘC] Key dịch vụ ngoài — cùng giá trị với root .env ─

# Groq: key 1, 2 (việc nhẹ), key 3, 4 (generation, xoay vòng). Chỉ key 1 bắt buộc.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

HF_TOKEN=

PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_SPARSE_INDEX_NAME=

# ── [TỰ SINH] Cách sinh: xem README ─────────────────────────

CHATBOT_API_KEY=
REDIS_PASSWORD=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Điền 1 lần rồi giữ nguyên mãi (đổi sẽ đăng xuất mọi người)
WEBUI_SECRET_KEY=

# Giữ nguyên placeholder, không sửa (compose tự dựng giá trị thật)
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CHATLOG_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres/chatbot

# ── [TÙY CHỌN] Chỉ cần với named tunnel; quick tunnel để trống ─

WEBUI_URL=
TUNNEL_TOKEN=
