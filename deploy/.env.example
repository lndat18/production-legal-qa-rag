# Mẫu biến môi trường cho toàn bộ stack Docker (deploy/docker-compose.yml).
#
# Cách dùng nhanh nhất: chạy ./deploy/up.sh — nó tự tạo deploy/.env từ file mẫu này, tự
# điền sẵn các key trùng với root .env (GROQ_API_KEY*, HF_TOKEN, PINECONE_*,
# CHATBOT_API_KEY) NẾU root .env đã có giá trị, rồi dừng lại để bạn điền nốt phần còn
# thiếu. Không cần tự `cp` tay.
#
# deploy/.env KHÔNG commit (đã khớp .gitignore ".env" ở mọi thư mục). Không truyền bí mật
# qua build-arg hay bake vào image. Đây là file RIÊNG với root .env.example (dev cục bộ,
# không qua Docker) — 2 file không dùng chung, xem deploy_spec.md mục 7.
#
# Kiểm tra deploy/.env có khớp danh sách biến với deploy/.env.example không (chỉ so TÊN
# biến, không lộ giá trị) — chạy từ root project:
#   diff <(grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' deploy/.env.example | sort) \
#        <(grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' deploy/.env | sort)
# Không in gì ra = khớp. Muốn kiểm tra cặp .env/.env.example ở root, đổi file_path của 2
# chỗ "deploy/.env.example"/"deploy/.env" ở trên thành ".env.example"/".env".

# ============================================================
# Cloudflare Tunnel — chọn chế độ (deploy_spec.md mục 3)
# ============================================================
# "quick" (mặc định): KHÔNG cần domain, MIỄN PHÍ, dùng được ngay — URL ngẫu nhiên
#         (*.trycloudflare.com), chỉ đổi khi container cloudflared-quick bị restart, không
#         đổi liên tục lúc đang chạy. Không cần sửa gì thêm ở dưới nếu chọn chế độ này.
# "named": cần bạn có domain riêng đã trỏ về Cloudflare, đổi lại URL cố định vĩnh viễn —
#          dựng named tunnel theo deploy_spec.md mục 3 trước, rồi mới đổi dòng dưới +
#          điền TUNNEL_TOKEN, WEBUI_URL.
COMPOSE_PROFILES=quick

# ============================================================
# [BẮT BUỘC] Key dịch vụ ngoài — CÙNG giá trị với root .env (nếu đã chạy dev cục bộ, copy
# nguyên qua; ./deploy/up.sh đã tự làm việc này cho bạn khi tạo file lần đầu, phần dưới chỉ
# cần điền tay khi seed tự động không có giá trị để lấy)
# ============================================================

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# [TÙY CHỌN] Key Groq thứ 2, tách rate limit — không set vẫn dùng GROQ_API_KEY.
GROQ_API_KEY_2=
# Hugging Face: https://huggingface.co/settings/tokens (token quyền "Read" là đủ)
HF_TOKEN=
# Pinecone: https://app.pinecone.io (mục "API Keys" trong dashboard)
PINECONE_API_KEY=
# Tên index đã tạo trên Pinecone dashboard — PHẢI khớp tên thật (giống root .env), không
# phải placeholder tuỳ ý.
PINECONE_INDEX_NAME=
PINECONE_SPARSE_INDEX_NAME=

# ============================================================
# [TỰ SINH] Không lấy từ dịch vụ ngoài nào — tự đặt/tự sinh bằng lệnh dưới, không cần nhớ
# giá trị (chỉ container dùng, không ai gõ tay đăng nhập bằng các key/mật khẩu này)
# ============================================================
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Key riêng giữa OpenWebUI và backend `api` (không phải key public của Groq/HF/Pinecone).
# Sinh bằng lệnh trên. Dùng lại đúng giá trị CHATBOT_API_KEY ở root .env cũng được, không
# bắt buộc phải khác.
CHATBOT_API_KEY=
# Mật khẩu cho Redis container (deploy tạo mới, không phải Redis có sẵn) — sinh bằng lệnh
# trên hoặc tự đặt tuỳ ý.
REDIS_PASSWORD=

# KHÔNG cần tự điền 2 dòng dưới: docker-compose.yml tự dựng đúng giá trị cho service `api`
# từ REDIS_PASSWORD/POSTGRES_USER/POSTGRES_PASSWORD ở trên/dưới (env_file không tự giãn
# ${VAR} bên trong chính .env). Giữ nguyên placeholder, đừng xoá hay sửa 2 dòng này.
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CHATLOG_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres/chatbot

# Postgres — container Postgres MỚI do compose tự tạo (không phải DB có sẵn ở đâu), tự đặt
# username/password tuỳ ý (vd. username "legalqa", password sinh bằng lệnh trên). Dùng
# chung cho 2 database openwebui + chatbot (deploy/initdb/001_create_databases.sh).
POSTGRES_USER=
POSTGRES_PASSWORD=

# Key ký session đăng nhập OpenWebUI. Sinh bằng lệnh trên. Điền 1 LẦN rồi GIỮ NGUYÊN MÃI
# MÃI — đổi sau khi đã có người đăng nhập sẽ làm mọi người (kể cả bạn) bị đăng xuất hết.
WEBUI_SECRET_KEY=

# ============================================================
# [TÙY CHỌN] Chỉ cần khi dùng named tunnel (COMPOSE_PROFILES=named ở trên) — quick tunnel
# (mặc định): để trống cả 2 dòng dưới
# ============================================================

# URL cố định của named tunnel, vd. https://chat.tenban.com
WEBUI_URL=
# Token lấy từ Cloudflare Zero Trust dashboard lúc tạo named tunnel.
TUNNEL_TOKEN=
