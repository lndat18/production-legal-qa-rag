# Copy file này thành .env rồi điền giá trị thật. Không commit .env.

# HF Inference API — dùng để embed văn bản (embedding/, retrieval/query_embedder.py)
HF_TOKEN=

# Groq — key org A dùng cho formatting/, HyDE (retrieval/) và guardrail (generation/)
GROQ_API_KEY=
# Key Groq thứ 2, TÙY CHỌN — generation/ ưu tiên key này để tách rate limit;
# formatting/ dùng nó để chạy 2 worker song song. Không set vẫn dùng GROQ_API_KEY.
GROQ_API_KEY_2=

# Pinecone — vector DB
PINECONE_API_KEY=
PINECONE_INDEX_NAME=legal-qa-vectors
# Sparse index (BM25) riêng cho keyword search — build bằng tools/sparse_index_documents.py
PINECONE_SPARSE_INDEX_NAME=legal-qa-sparse

# Redis — cache, quota theo ngày (conversation/admission.py), rate limit; chỉ dùng trong mạng nội bộ
REDIS_URL=redis://localhost:6379/0

# Reranker server — tự host trên LightningAI
# RERANKER_ENDPOINT_URL: Lấy từ ngrok
RERANKER_ENDPOINT_URL=
RERANKER_API_KEY=
# SSH vào Studio đang host reranker_server/ — cần để khởi động lại server/tunnel sau khi Studio restart
LIGHTNING_STUDIO_SSH=
