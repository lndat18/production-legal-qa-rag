# cp .env.example .env rồi điền giá trị thật. KHÔNG commit .env.
# Hướng dẫn từng biến: README.md, mục "Cấu hình biến môi trường".
#
# Toàn bộ biến môi trường của project (app dev, deploy production, observability dev) gộp
# vào ĐÚNG 1 CẶP FILE này ở root — không còn .env/.env.example nào khác trong repo. Chia 3
# block bằng comment bên dưới; prefix DEPLOY_/OBS_ chỉ áp dụng cho biến bị trùng tên giữa 2
# domain (Postgres riêng của mỗi domain) — biến không trùng thì giữ nguyên tên gốc.

# ============================================================
# APP — production_legal_qa_rag/config.py đọc trực tiếp (dev cục bộ, `uv run ...` trên
# host). Container `api` của deploy/docker-compose.yml (production) cũng đọc nguyên file
# này qua `env_file: ../.env` nên các biến LLM/HF/Pinecone/CHATBOT_API_KEY dùng CHUNG cho cả
# 2 — không lặp lại ở block DEPLOY.
# ============================================================

# ── [BẮT BUỘC] Key dịch vụ ngoài ────────────────────────────

# Groq — mỗi key nên từ 1 tài khoản Groq khác nhau (rate limit tính theo tài khoản, không
# theo key). Key 1 (guardrail, condense, HyDE); key 2 (Judge, tuỳ chọn, mặc định dùng key 1);
# key 3, 4 (generation, xoay vòng; tuỳ chọn, mặc định dùng key 1).
# Key 5, 6 chỉ dùng cho tools/generate_testset.py: script này xoay vòng CẢ 6 key
# (bắt buộc đủ 6, chạy khi không có traffic thật).
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=

# Hugging Face — embedding
HF_TOKEN=

# Pinecone — tên index phải khớp index đã tạo
PINECONE_API_KEY=
PINECONE_INDEX_NAME=legal-qa-vectors
PINECONE_SPARSE_INDEX_NAME=legal-qa-sparse

# ── [TỰ SINH] ───────────────────────────────────────────────

# Secret giữa OpenWebUI và backend — dùng chung cho cả dev (host) và deploy (Docker).
# Sinh: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CHATBOT_API_KEY=

# ── [TÙY CHỌN] Mặc định trỏ Redis chạy cục bộ trên localhost ─

REDIS_URL=redis://localhost:6379/0
# CACHE_CORPUS_VERSION=

# Để trống dùng mặc định
RERANKER_MODEL_NAME=
RERANKER_MAX_LENGTH=
RERANKER_BATCH_SIZE=

# Để trống dùng mặc định
RATE_LIMIT_PER_MINUTE=
KEEPALIVE_SECONDS=

# Langfuse self-host (observability_spec.md mục 6) — để trống là chatbot vẫn chạy bình
# thường, chỉ mất trace (SDK tự chuyển sang chế độ disabled, không lỗi). Tạo project + API
# key trên UI Langfuse (http://localhost:3001) sau khi đã chạy
# dev/observability/docker-compose.yml lần đầu.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# api chạy trực tiếp trên host (không qua Docker) nên phải trỏ vào
# cổng đã publish ra host, không phải tên service `langfuse-web` trong network Docker.
LANGFUSE_BASE_URL=http://localhost:3001

# ============================================================
# DEPLOY — deploy/docker-compose.yml (production, chạy bằng ./deploy/up.sh).
# Biến LLM/HF/Pinecone/CHATBOT_API_KEY dùng chung với block APP ở trên — KHÔNG lặp lại ở
# đây, container `api` đọc nguyên file .env này.
# ============================================================

# Chế độ tunnel: quick (mặc định, không cần domain) hoặc named
COMPOSE_PROFILES=quick

# ── [TỰ SINH] Cách sinh: xem README ─────────────────────────

# Postgres RIÊNG cho production (chỉ phục vụ OpenWebUI, DB openwebui). Prefix DEPLOY_ vì
# trùng tên với Postgres riêng của OBSERVABILITY bên dưới (2 instance khác nhau).
DEPLOY_POSTGRES_USER=
DEPLOY_POSTGRES_PASSWORD=

REDIS_PASSWORD=
# Điền 1 lần rồi giữ nguyên mãi (đổi sẽ đăng xuất mọi người)
WEBUI_SECRET_KEY=

# ── [TÙY CHỌN] Chỉ cần với named tunnel; quick tunnel để trống ─

WEBUI_URL=
TUNNEL_TOKEN=

# ============================================================
# OBSERVABILITY — dev/observability/docker-compose.yml (Langfuse self-host +
# Prometheus + Grafana, CHỈ chạy dev/local, không dùng trong production).
# Prefix OBS_ vì Postgres/Redis ở đây RIÊNG, không liên quan Postgres/Redis của APP/DEPLOY.
# Sinh ngẫu nhiên: openssl rand -hex 16 (password) / openssl rand -hex 32 (SALT/
# ENCRYPTION_KEY/NEXTAUTH_SECRET — ENCRYPTION_KEY bắt buộc đúng 64 ký tự hex).
# ============================================================

OBS_POSTGRES_USER=langfuse
OBS_POSTGRES_PASSWORD=
OBS_POSTGRES_DB=langfuse

OBS_REDIS_AUTH=

OBS_CLICKHOUSE_USER=clickhouse
OBS_CLICKHOUSE_PASSWORD=

OBS_MINIO_ROOT_USER=minio
OBS_MINIO_ROOT_PASSWORD=

OBS_SALT=
OBS_ENCRYPTION_KEY=
OBS_NEXTAUTH_SECRET=
OBS_TELEMETRY_ENABLED=false

OBS_GRAFANA_ADMIN_USER=admin
OBS_GRAFANA_ADMIN_PASSWORD=
