# cp .env.example .env rồi điền giá trị thật. KHÔNG commit .env.
# Hướng dẫn từng biến: README.md, mục "Cấu hình biến môi trường".
# (Deploy Docker dùng file riêng deploy/.env — xem deploy/.env.example.)

# ── [BẮT BUỘC] Key dịch vụ ngoài ────────────────────────────

# Groq — mỗi key nên từ 1 tài khoản Groq khác nhau.
# Key 1 (guardrail, condense, HyDE); key 2 (Judge, tùy chọn, mặc định dùng key 1);
# key 3, 4 (generation, xoay vòng; tùy chọn, mặc định dùng key 1).
# Key 5, 6 chỉ dùng cho tools/generate_testset.py: script này xoay vòng CẢ 6 key
# (bắt buộc đủ 6, chạy khi không có traffic thật).
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=

# Hugging Face — embedding
HF_TOKEN=

# Pinecone — tên index phải khớp index đã tạo
PINECONE_API_KEY=
PINECONE_INDEX_NAME=legal-qa-vectors
PINECONE_SPARSE_INDEX_NAME=legal-qa-sparse

# ── [TỰ SINH] ───────────────────────────────────────────────

# Secret giữa OpenWebUI và backend (cách sinh: xem README)
CHATBOT_API_KEY=

# ── [TÙY CHỌN] Giữ nguyên nếu chạy deploy/dev/docker-compose.yml ─

REDIS_URL=redis://localhost:6379/0
# CACHE_CORPUS_VERSION=

# Để trống dùng mặc định
RERANKER_MODEL_NAME=
RERANKER_MAX_LENGTH=
RERANKER_BATCH_SIZE=

CHATLOG_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatbot
CHATLOG_RETENTION_DAYS=90

# Để trống dùng mặc định
RATE_LIMIT_PER_MINUTE=
KEEPALIVE_SECONDS=

# Langfuse self-host (observability_spec.md mục 6) — để trống là chatbot vẫn chạy
# bình thường, chỉ mất trace (SDK tự chuyển sang chế độ disabled, không lỗi).
# Tạo project + API key trên UI Langfuse (http://localhost:3001) sau khi đã chạy
# deploy/dev/observability/docker-compose.yml lần đầu.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# api chạy trực tiếp trên host (không qua deploy/dev/docker-compose.yml) nên phải trỏ
# vào cổng đã publish ra host, không phải tên service `langfuse-web` trong network Docker.
LANGFUSE_BASE_URL=http://localhost:3001
