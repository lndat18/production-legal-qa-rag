# Copy file này thành .env rồi điền giá trị thật. Không commit .env.

# HF Inference API — dùng để embed văn bản (embedding/, retrieval/query_embedder.py)
HF_TOKEN=

# Groq — LLM dùng cho formatting/ (convert front/back matter) và HyDE (retrieval/)
GROQ_API_KEY=
# Key Groq thứ 2, TÙY CHỌN — có sẽ chạy 2 worker song song, không có vẫn chạy bình thường (1 key tuần tự)
GROQ_API_KEY_2=

# Pinecone — vector DB
PINECONE_API_KEY=
PINECONE_INDEX_NAME=legal-qa-vectors

# Reranker server — tự host trên LightningAI (xem reranker_server/), retrieval/ gọi qua HTTP
RERANKER_ENDPOINT_URL=
RERANKER_API_KEY=
# SSH vào Studio đang host reranker_server/ — cần để khởi động lại server/tunnel sau khi Studio restart
LIGHTNING_STUDIO_SSH=
