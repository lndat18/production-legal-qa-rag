# Copy file này thành .env rồi điền giá trị thật. Không commit .env.

# HF Inference API — dùng để embed văn bản (embedding/, retrieval/query_embedder.py)
HF_TOKEN=

# Groq — key org A dùng cho formatting/, HyDE (retrieval/) và guardrail (generation/)
GROQ_API_KEY=
# Key Groq thứ 2, TÙY CHỌN — generation/ ưu tiên key này để tách rate limit;
# formatting/ dùng nó để chạy 2 worker song song. Không set vẫn dùng GROQ_API_KEY.
GROQ_API_KEY_2=

# Pinecone — vector DB
PINECONE_API_KEY=
PINECONE_INDEX_NAME=legal-qa-vectors
# Sparse index (BM25) riêng cho keyword search — build bằng tools/sparse_index_documents.py
PINECONE_SPARSE_INDEX_NAME=legal-qa-sparse

# Redis — cache, quota theo ngày (conversation/admission.py), rate limit; chỉ dùng trong mạng nội bộ
REDIS_URL=redis://localhost:6379/0
# Tuỳ chọn: ghi đè corpus version khi BM25 index được quản lý ngoài quy trình fit chuẩn.
CACHE_CORPUS_VERSION=

# Reranker chạy in-process. Các giá trị dưới đây là tuỳ chọn; mặc định lần lượt
# là AITeamVN/Vietnamese_Reranker, 512 và 16.
RERANKER_MODEL_NAME=
RERANKER_MAX_LENGTH=
RERANKER_BATCH_SIZE=

# Postgres — chatlog (database riêng `chatbot`, chung instance với OpenWebUI)
# Driver phải là postgresql+asyncpg
CHATLOG_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatbot
# Số ngày lưu trữ chatlog; dùng bởi tools/purge_chatlog.py (mặc định 90)
CHATLOG_RETENTION_DAYS=90
