# Copy sang .env; không commit .env. Hướng dẫn: docs/configuration.md.

# APP — dùng chung trên host và container API
# Production cần key 1; evaluation cần đủ key 1–9.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=
GROQ_API_KEY_9=

HF_TOKEN=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=legal-qa-vectors
PINECONE_SPARSE_INDEX_NAME=legal-qa-sparse
CHATBOT_API_KEY=

REDIS_URL=redis://localhost:6379/0
# CACHE_CORPUS_VERSION=
# Reranker: để trống dùng mặc định.
RERANKER_MODEL_NAME=
RERANKER_MAX_LENGTH=
RERANKER_BATCH_SIZE=
RATE_LIMIT_PER_MINUTE=5
KEEPALIVE_SECONDS=15

# Langfuse: để trống key thì không có trace.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3001

# DEPLOY — ./deploy/up.sh
COMPOSE_PROFILES=quick
DEPLOY_POSTGRES_USER=
DEPLOY_POSTGRES_PASSWORD=
REDIS_PASSWORD=
WEBUI_SECRET_KEY=
# Chỉ cần với named tunnel.
WEBUI_URL=
TUNNEL_TOKEN=

# OBSERVABILITY — ./observability/up.sh
OBS_POSTGRES_USER=langfuse
OBS_POSTGRES_PASSWORD=
OBS_POSTGRES_DB=langfuse
OBS_REDIS_AUTH=
OBS_CLICKHOUSE_USER=clickhouse
OBS_CLICKHOUSE_PASSWORD=
OBS_MINIO_ROOT_USER=minio
OBS_MINIO_ROOT_PASSWORD=
OBS_SALT=
# Bắt buộc đúng 64 ký tự hex.
OBS_ENCRYPTION_KEY=
OBS_NEXTAUTH_SECRET=
OBS_TELEMETRY_ENABLED=false
OBS_GRAFANA_ADMIN_USER=admin
OBS_GRAFANA_ADMIN_PASSWORD=
