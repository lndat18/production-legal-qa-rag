# Native Codex execpolicy migration of .claude/settings.json.
# A matching `forbidden` rule always overrides a matching `allow` rule.

# Git commands allowed by the Claude configuration.
prefix_rule(pattern = ["git", "push"], decision = "allow")
prefix_rule(pattern = ["git", "commit"], decision = "allow")
prefix_rule(pattern = ["git", "add"], decision = "allow")
prefix_rule(pattern = ["git", "checkout"], decision = "allow")
prefix_rule(pattern = ["git", "pull"], decision = "allow")
prefix_rule(pattern = ["git", "status"], decision = "allow")
prefix_rule(pattern = ["git", "log"], decision = "allow")
prefix_rule(pattern = ["git", "diff"], decision = "allow")
prefix_rule(pattern = ["git", "show"], decision = "allow")
prefix_rule(pattern = ["git", "branch"], decision = "allow")
prefix_rule(pattern = ["git", "remote"], decision = "allow")
prefix_rule(pattern = ["git", "fetch"], decision = "allow")
prefix_rule(pattern = ["git", "blame"], decision = "allow")
prefix_rule(pattern = ["git", "ls-files"], decision = "allow")
prefix_rule(pattern = ["git", "rev-parse"], decision = "allow")
prefix_rule(pattern = ["git", "stash", "list"], decision = "allow")
prefix_rule(pattern = ["git", "config", "--get"], decision = "allow")

# GitHub CLI commands allowed by the Claude configuration.
prefix_rule(pattern = ["gh", "pr", "merge"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "create"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "comment"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "view"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "list"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "diff"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "checks"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "status"], decision = "allow")
prefix_rule(pattern = ["gh", "run", "view"], decision = "allow")
prefix_rule(pattern = ["gh", "run", "list"], decision = "allow")
prefix_rule(pattern = ["gh", "workflow", "view"], decision = "allow")
prefix_rule(pattern = ["gh", "workflow", "list"], decision = "allow")
prefix_rule(pattern = ["gh", "repo", "view"], decision = "allow")
prefix_rule(pattern = ["gh", "auth", "status"], decision = "allow")

# Python validation commands allowed by the Claude configuration.
prefix_rule(pattern = ["uv", "run", "pytest"], decision = "allow")
prefix_rule(pattern = ["uv", "run", "ruff"], decision = "allow")
prefix_rule(pattern = ["uv", "run", "mypy"], decision = "allow")

# Read-only shell commands allowed by the Claude configuration.
prefix_rule(pattern = ["grep"], decision = "allow")
prefix_rule(pattern = ["rg"], decision = "allow")
prefix_rule(pattern = ["find"], decision = "allow")
prefix_rule(pattern = ["cat"], decision = "allow")
prefix_rule(pattern = ["ls"], decision = "allow")
prefix_rule(pattern = ["head"], decision = "allow")
prefix_rule(pattern = ["tail"], decision = "allow")
prefix_rule(pattern = ["wc"], decision = "allow")
prefix_rule(pattern = ["sed", "-n"], decision = "allow")
prefix_rule(pattern = ["sort"], decision = "allow")
prefix_rule(pattern = ["cut"], decision = "allow")
prefix_rule(pattern = ["jq"], decision = "allow")
prefix_rule(pattern = ["tree"], decision = "allow")

# Commands explicitly denied by the Claude configuration.
prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force-push is forbidden by this repository's command policy.",
)
prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Force-push is forbidden by this repository's command policy.",
)
prefix_rule(
    pattern = ["git", "push", "origin", "--force"],
    decision = "forbidden",
    justification = "Force-push is forbidden by this repository's command policy.",
)
prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Use a targeted, recoverable Git operation instead of git reset --hard.",
)
prefix_rule(
    pattern = ["git", "branch", "-D"],
    decision = "forbidden",
    justification = "Force-deleting a branch is forbidden by this repository's command policy.",
)
prefix_rule(
    pattern = ["git", "branch", "--delete", "--force"],
    decision = "forbidden",
    justification = "Force-deleting a branch is forbidden by this repository's command policy.",
)
prefix_rule(
    pattern = ["gh", "pr", "merge", "--admin"],
    decision = "forbidden",
    justification = "Admin-merging a pull request is forbidden by this repository's command policy.",
)
